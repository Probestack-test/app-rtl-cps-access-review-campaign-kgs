{
  "info": {
    "name": "Access Review Campaign Postman Collection",
    "description": "Automated access review campaigns for SOC2, ISO 27001, and HIPAA compliance. \nManages quarterly access certification cycles — who still needs what access \nto which systems. Prevents privilege creep by requiring managers and system \nowners to explicitly re-approve every user's access on a scheduled cadence. \nGenerates auditor-ready certification evidence proving reviews happened.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
